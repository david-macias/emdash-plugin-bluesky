---
/**
 * BlueskyCard — shared card for one normalized Bluesky post.
 *
 * Used by BlueskyFeed (list) and BlueskyPost (single embed). Quote posts
 * render inline (text only, no recursion) so a quote of a quote cannot
 * nest forever.
 *
 * Styling inherits the site: no palette is hard-coded. Muted text uses
 * opacity, borders use color-mix against currentColor (with a plain
 * fallback first for older browsers), and headings use the site's
 * --font-heading token when the theme defines one.
 */
import type { NormalizedPost } from "emdash-plugin-bluesky/types";

interface Props {
  post: NormalizedPost;
  showCounts?: boolean;
  showImages?: boolean;
}

const { post, showCounts = true, showImages = true } = Astro.props;

function formatDate(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return iso;
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

function hostOf(uri: string): string {
  try {
    return new URL(uri).hostname;
  } catch {
    return uri;
  }
}

const countParts: string[] = [];
if (showCounts) {
  if (post.replyCount > 0) countParts.push(`${post.replyCount} ${post.replyCount === 1 ? "reply" : "replies"}`);
  if (post.repostCount > 0) countParts.push(`${post.repostCount} ${post.repostCount === 1 ? "repost" : "reposts"}`);
  if (post.likeCount > 0) countParts.push(`${post.likeCount} ${post.likeCount === 1 ? "like" : "likes"}`);
}
---

<article class="bsky-card">
  {
    post.repostedByHandle && (
      <p class="bsky-repost">Reposted by @{post.repostedByHandle}</p>
    )
  }
  <header class="bsky-card-head">
    {
      post.authorAvatar && (
        <img
          class="bsky-avatar"
          src={post.authorAvatar}
          alt=""
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <span class="bsky-author">
      <span class="bsky-display">{post.authorDisplayName}</span>
      <span class="bsky-handle">@{post.authorHandle}</span>
    </span>
    <a class="bsky-time" href={post.url} target="_blank" rel="noopener noreferrer">
      <time datetime={post.createdAt}>{formatDate(post.createdAt)}</time>
    </a>
  </header>

  <p class="bsky-text">
    {
      post.segments.map((segment) =>
        segment.href ? (
          <a href={segment.href} target="_blank" rel="noopener noreferrer">
            {segment.text}
          </a>
        ) : (
          segment.text
        ),
      )
    }
  </p>

  {
    showImages && post.images && post.images.length > 0 && (
      <div class="bsky-images">
        {post.images.map((image) => (
          <a href={post.url} target="_blank" rel="noopener noreferrer" aria-label="View on Bluesky">
            <img src={image.thumb} alt={image.alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    )
  }

  {
    post.external && (
      <a class="bsky-external" href={post.external.uri} target="_blank" rel="noopener noreferrer">
        {post.external.thumb && (
          <img src={post.external.thumb} alt="" loading="lazy" decoding="async" />
        )}
        <span class="bsky-external-body">
          <span class="bsky-external-title">{post.external.title}</span>
          {post.external.description && (
            <span class="bsky-external-desc">{post.external.description}</span>
          )}
          <span class="bsky-external-host">{hostOf(post.external.uri)}</span>
        </span>
      </a>
    )
  }

  {
    post.quote && (
      <div class="bsky-quote">
        <p class="bsky-quote-head">
          <span class="bsky-display">{post.quote.authorDisplayName}</span>
          <span class="bsky-handle">@{post.quote.authorHandle}</span>
        </p>
        <p class="bsky-text">
          {
            post.quote.segments.map((segment) =>
              segment.href ? (
                <a href={segment.href} target="_blank" rel="noopener noreferrer">
                  {segment.text}
                </a>
              ) : (
                segment.text
              ),
            )
          }
        </p>
        <p class="bsky-quote-link">
          <a href={post.quote.url} target="_blank" rel="noopener noreferrer">
            View quoted post on Bluesky
          </a>
        </p>
      </div>
    )
  }

  {
    countParts.length > 0 && (
      <p class="bsky-counts">
        {countParts.join(" · ")} ·{" "}
        <a href={post.url} target="_blank" rel="noopener noreferrer">
          View on Bluesky
        </a>
      </p>
    )
  }
  {
    countParts.length === 0 && (
      <p class="bsky-counts">
        <a href={post.url} target="_blank" rel="noopener noreferrer">
          View on Bluesky
        </a>
      </p>
    )
  }
</article>

<style>
  .bsky-card {
    border: 1px solid #e3ddd2;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.75rem;
    padding: 1rem 1.125rem;
  }
  .bsky-repost {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    opacity: 0.75;
  }
  .bsky-card-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .bsky-avatar {
    border-radius: 9999px;
    flex: none;
  }
  .bsky-author {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
  }
  .bsky-display {
    font-family: var(--font-heading, Georgia, "Times New Roman", serif);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bsky-handle {
    font-size: 0.875rem;
    opacity: 0.75;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bsky-time {
    margin-left: auto;
    flex: none;
    font-size: 0.875rem;
    opacity: 0.75;
    text-decoration: none;
  }
  .bsky-time:hover {
    text-decoration: underline;
  }
  .bsky-text {
    margin: 0.75rem 0 0;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .bsky-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .bsky-images img {
    width: 100%;
    height: 100%;
    max-height: 18rem;
    object-fit: cover;
    border-radius: 0.5rem;
    display: block;
  }
  .bsky-external {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    border: 1px solid #e3ddd2;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.5rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .bsky-external > img {
    width: 6.5rem;
    flex: none;
    object-fit: cover;
  }
  .bsky-external-body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    min-width: 0;
  }
  .bsky-external-title {
    font-weight: 600;
  }
  .bsky-external-desc,
  .bsky-external-host {
    font-size: 0.875rem;
    opacity: 0.75;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .bsky-quote {
    margin-top: 0.75rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid #e3ddd2;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 0.5rem;
  }
  .bsky-quote-head {
    margin: 0;
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
  .bsky-quote .bsky-text {
    margin-top: 0.375rem;
  }
  .bsky-quote-link {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
  }
  .bsky-counts {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    opacity: 0.75;
  }
</style>
